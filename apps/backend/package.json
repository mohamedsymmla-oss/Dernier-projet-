{
  "name": "@wa/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "migrate": "tsx --env-file-if-exists=../../.env src/cli/migrate.ts",
    "migrate:prod": "node dist/migrate.js",
    "create-user:prod": "node dist/create-user.js",
    "create-user": "tsx --env-file-if-exists=../../.env src/cli/create-user.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@aws-sdk/s3-request-presigner": "^3.1140.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.5",
    "@wa/provider-connectors": "1.0.0",
    "@wa/shared": "1.0.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.8",
    "fastify": "^5.12.5",
    "file-type": "^22.1.1",
    "image-size": "^2.0.4",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "music-metadata": "^11.16.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "undici": "^8.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
