# ===================================================================
# Variables d'environnement du backend (à définir dans Railway).
# NE JAMAIS committer de vraies valeurs. Aucune de ces valeurs ne va dans l'APK.
# ===================================================================

# --- Obligatoires ---
DATABASE_URL=              # Railway : ${{Postgres.DATABASE_URL}}
REDIS_URL=                 # Railway : ${{Redis.REDIS_URL}}
ENCRYPTION_KEY=            # 32 octets : openssl rand -hex 32   (chiffre les clés API en base — à sauvegarder !)
JWT_SECRET=                # 32+ caractères : openssl rand -hex 32
PUBLIC_BACKEND_URL=        # ex : https://mon-backend.up.railway.app  (sert à construire l'URL du webhook)

# --- Premier compte (créé au premier démarrage s'il n'existe aucun compte) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=            # 10 caractères minimum

# --- Stockage durable des médias (S3, Cloudflare R2, MinIO...) ---
# Sans ces variables : import de fichiers « À configurer », les URL publiques restent possibles.
S3_ENDPOINT=               # R2 : https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=        # optionnel : domaine public du bucket ; sinon URL pré-signées temporaires
S3_FORCE_PATH_STYLE=false  # true pour MinIO
MEDIA_URL_TTL_SECONDS=21600

# --- SendZen ---
SENDZEN_API_BASE_URL=          # optionnel (défaut https://api.sendzen.io)
SENDZEN_SANDBOX_API_BASE_URL=  # optionnel : URL API utilisée par les connexions en mode TEST
SENDZEN_PARTNER_API_KEY=       # optionnel : Partner API / Embedded Onboarding (à configurer)

# --- Réglages d'envoi (valeurs par défaut prudentes) ---
A1_CONCURRENCY=4                   # contacts Automation 1 traités en parallèle
PROVIDER_MAX_MESSAGES_PER_SECOND=10
STEP_GAP_MS=1500                   # pause entre deux messages d'une même séquence (ordre d'arrivée)
SEND_MAX_ATTEMPTS=5
RETRY_BASE_MS=2000
RETRY_MAX_MS=300000

# --- Serveur ---
PORT=3000
APP_ROLE=all              # all | api | worker
LOG_LEVEL=info
CORS_ORIGINS=             # optionnel, ex : https://mon-app-web.example.com
DATABASE_SSL=false
